# Copy to .env.local for local development. On Vercel, set these in Project -> Settings -> Environment Variables.
# Never commit real values.

# --- Required on Vercel -------------------------------------------------------------------------------------------
# Postgres connection string (added automatically when you connect a Neon database from the Vercel Marketplace).
DATABASE_URL=
# Vercel Blob token for storing finished videos (added automatically when you connect a Blob store).
BLOB_READ_WRITE_TOKEN=
# The GPU worker (see docs/deploy-vercel.md).
CLIPNOVA_WORKER_URL=
CLIPNOVA_WORKER_TOKEN=
# Which models to offer. For now only one: ltx.
CLIPNOVA_WORKER_MODELS=ltx
# Shared access code for the private test (10+ characters). Without it the deployment refuses everyone.
CLIPNOVA_ACCESS_CODE=
# There is no sign-in yet; this enables the demo user per plan. Only ever with the access code above.
CLIPNOVA_DEMO=1

# --- Optional -------------------------------------------------------------------------------------------------------
# CLIPNOVA_JOB_TIMEOUT_MS=1500000        # a video older than this is failed and refunded (default 25 min)
# CLIPNOVA_WORKER_LOSS_MS=180000         # worker unreachable this long: fail and refund (default 3 min)
# CLIPNOVA_DB_POOL=3                     # connections per serverless instance
# CLIPNOVA_DATA_DIR=.data                # local development only: embedded database and video files
